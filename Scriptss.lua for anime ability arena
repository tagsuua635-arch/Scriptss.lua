-- ========= FOLLOW LOGIC =========
local function clearDeathConn()
	if deathConn then deathConn:Disconnect() deathConn = nil end
end

local pickNearest -- forward

local function stopFollow(msg)
	followOn = false
	randomOn = false
	currentTarget = nil
	clearDeathConn()
	if setFollowUI then setFollowUI(false) end
	if setRandomUI then setRandomUI(false) end
	statusLbl.Text = "Status: " .. (msg or "follow mati/berhenti")
end

local watchedChar = nil
local handlingDeath = false

local function onTargetDead()
	if handlingDeath then return end
	handlingDeath = true
	if randomOn then
		task.delay(0.3, function()
			handlingDeath = false
			pickNearest()         -- pindah ke player terdekat berikutnya
		end)
	else
		handlingDeath = false
		stopFollow("target mati, follow berhenti")
	end
end

local function watchTarget(plr)
	clearDeathConn()
	watchedChar = plr.Character
	local hum = plr.Character and plr.Character:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	deathConn = hum.Died:Connect(onTargetDead)
end

pickNearest = function()
	local best, bestDist
	if isAlive(LP) then
		local myPos = LP.Character.HumanoidRootPart.Position
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= LP and isAlive(p) then
				local d = (p.Character.HumanoidRootPart.Position - myPos).Magnitude
				if not bestDist or d < bestDist then best, bestDist = p, d end
			end
		end
	end
	if not best then
		currentTarget = nil
		statusLbl.Text = "Status: tidak ada player hidup"
		return
	end
	currentTarget = best
	targetLbl.Text = "Target (terdekat): " .. best.Name
	statusLbl.Text = "Status: mengikuti terdekat"
	watchTarget(best)
end

selectBtn.MouseButton1Click:Connect(function()
	if not selectedName then
		statusLbl.Text = "Status: pilih player dulu"
		return
	end
	local p = Players:FindFirstChild(selectedName)
	if not p then
		statusLbl.Text = "Status: player sudah keluar"
		return
	end
	confirmedTarget = p
	targetLbl.Text = "Target: " .. p.Name
	statusLbl.Text = "Status: target dipilih"
end)

setFollowUI = toggleRow("Follow Player (Select)", function()
	if not confirmedTarget or not confirmedTarget.Parent then
		statusLbl.Text = "Status: tekan SELECT PLAYER dulu"
		return false
	end
	if not isAlive(confirmedTarget) then
		statusLbl.Text = "Status: target sedang mati"
		return false
	end
	randomOn = false
	if setRandomUI then setRandomUI(false) end
	followOn = true
	currentTarget = confirmedTarget
	targetLbl.Text = "Target: " .. currentTarget.Name
	statusLbl.Text = "Status: mengikuti " .. currentTarget.Name
	watchTarget(currentTarget)
	return true
end, function()
	stopFollow("follow nonaktif")
end)

setRandomUI = toggleRow("Follow Terdekat (Otomatis)", function()
	followOn = false
	if setFollowUI then setFollowUI(false) end
	randomOn = true
	followOn = true
	currentTarget = nil
	pickNearest()
	return true
end, function()
	stopFollow("follow terdekat nonaktif")
end)

-- Loop ikut gerak (jalan maupun diam)
track(RunService.Heartbeat:Connect(function()
	if not (followOn or randomOn) then return end
	if not currentTarget then
		if randomOn and isAlive(LP) then pickNearest() end
		return
	end
	-- target mati / respawn (karakter berganti) -> langsung berhenti / pindah
	if not isAlive(currentTarget) or currentTarget.Character ~= watchedChar then
		onTargetDead()
		return
	end
	if not isAlive(LP) then return end
	local tHRP = currentTarget.Character.HumanoidRootPart
	local myHRP = LP.Character.HumanoidRootPart
	myHRP.CFrame = tHRP.CFrame * CFrame.new(0, 0, 3)
	myHRP.AssemblyLinearVelocity = Vector3.zero
end))

-- Target random respawn / target hilang
track(Players.PlayerRemoving:Connect(function(p)
	if p == currentTarget then
		if randomOn then pickNearest() else stopFollow("target keluar server") end
	end
end))

-- ========= AIMLOCK =========
local function nearestPlayer()
	if not isAlive(LP) then return nil end
	local myPos = LP.Character.HumanoidRootPart.Position
	local best, bestDist
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP and isAlive(p) then
			local d = (p.Character.HumanoidRootPart.Position - myPos).Magnitude
			if not bestDist or d < bestDist then best, bestDist = p, d end
		end
	end
	return best
end

local function setAim(state)
	aimOn = state
	pcall(function() RunService:UnbindFromRenderStep("AimlockFA") end)
	if state then
		RunService:BindToRenderStep("AimlockFA", Enum.RenderPriority.Camera.Value + 1, function()
			local p = nearestPlayer()
			if not p then return end
			local head = p.Character:FindFirstChild("Head") or p.Character.HumanoidRootPart
			Camera = workspace.CurrentCamera
			Camera.CFrame = CFrame.new(Camera.CFrame.Position, head.Position)
		end)
	end
end

setAimUI = toggleRow("Aimlock (player terdekat)", function() setAim(true) return true end, function() setAim(false) end)

-- ========= DRAG =========
do
	local dragging, dragStart, startPos
	title.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging, dragStart, startPos = true, i.Position, main.Position
			i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)
	track(UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - dragStart
			main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end))
end

